{
  "name": "@garvj65/tinytrace",
  "version": "2.0.2",
  "description": "A zero-runtime-dependency TypeScript error-tracking SDK for Node.js and browsers",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./integrations": {
      "import": {
        "types": "./dist/integrations.d.ts",
        "default": "./dist/integrations.js"
      },
      "require": {
        "types": "./dist-cjs/integrations.d.ts",
        "default": "./dist-cjs/integrations.js"
      }
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "docs/demo.gif",
    "docs/SDK.md",
    "docs/VALIDATION.md",
    "RELEASING.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node examples/demo.mjs",
    "ingest": "npm run build && node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "verify:package": "npm run build && node scripts/package-smoke.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check": "npm test && npm run check:budget && npm run demo && npm run verify:package",
    "verify:registry": "npm run build && node scripts/verify-registry.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "keywords": [
    "errors",
    "monitoring",
    "sdk",
    "typescript"
  ],
  "author": "Garv Jhajharia",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "express": "5.3.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garvj65/tinytrace.git"
  },
  "homepage": "https://github.com/garvj65/tinytrace#readme",
  "bugs": {
    "url": "https://github.com/garvj65/tinytrace/issues"
  }
}
